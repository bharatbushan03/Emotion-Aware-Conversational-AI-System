# Backend environment variables

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins allowed to call the API.
# Add the Vercel production URL after the first frontend deploy.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vercel preview URLs are allowed by this pattern as well.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Persistent paths. On Render these point at the mounted disk.
CHROMA_DB_PATH=./chroma_db_storage
HF_HOME=./.hf_cache

EMOTION_MODEL_NAME=bhadresh-savani/bert-base-go-emotion
SARCASM_MODEL_NAME=helinivan/english-sarcasm-detector
GENERATION_MODEL_NAME=google/flan-t5-small
